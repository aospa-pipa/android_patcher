From 16cfbc63c02e57f045cf427e8ba02cf5a5129047 Mon Sep 17 00:00:00 2001
From: Yuan Si <do4suki@gmail.com>
Date: Fri, 22 Sep 2023 16:33:18 +0800
Subject: [PATCH 02/21] drivers: ksu: Hardcode KSU git version

Change-Id: I43d3faf85a0d64bc4e02b0d89d9de21e428af281
Signed-off-by: Yuan Si <do4suki@gmail.com>
---
 drivers/ksu/Makefile | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/drivers/ksu/Makefile b/drivers/ksu/Makefile
index 5ba201cf259f..9c4c95c7bdd1 100644
--- a/drivers/ksu/Makefile
+++ b/drivers/ksu/Makefile
@@ -12,17 +12,12 @@ obj-y += embed_ksud.o
 obj-y += kernel_compat.o
 
 obj-y += selinux/
-# .git is a text file while the module is imported by 'git submodule add'.
-ifeq ($(shell test -e $(srctree)/$(src)/../.git; echo $$?),0)
-KSU_GIT_VERSION := $(shell cd $(srctree)/$(src); /usr/bin/env PATH="$$PATH":/usr/bin:/usr/local/bin git rev-list --count HEAD)
+
+KSU_GIT_VERSION := 1044
 # ksu_version: major * 10000 + git version + 200 for historical reasons
 $(eval KSU_VERSION=$(shell expr 10000 + $(KSU_GIT_VERSION) + 200))
 $(info -- KernelSU version: $(KSU_VERSION))
 ccflags-y += -DKSU_VERSION=$(KSU_VERSION)
-else # If there is no .git file, the default version will be passed.
-$(warning "KSU_GIT_VERSION not defined! It is better to make KernelSU a git submodule!")
-ccflags-y += -DKSU_VERSION=16
-endif
 
 ifndef KSU_EXPECTED_SIZE
 KSU_EXPECTED_SIZE := 0x033b
-- 
2.47.1

