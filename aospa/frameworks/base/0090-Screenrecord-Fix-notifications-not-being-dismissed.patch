     private Intent getDeleteIntent(Context context, Uri path) {
-        return new Intent(context, this.getClass()).setAction(ACTION_DELETE)
-                .putExtra(EXTRA_PATH, path);
+        return getDeleteIntent(context, path, mNotificationId);
