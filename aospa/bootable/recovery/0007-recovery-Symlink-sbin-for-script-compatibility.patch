 etc/init.rc | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/etc/init.rc b/etc/init.rc
index 3eacac930..d94d0f65f 100644
--- a/etc/init.rc
+++ b/etc/init.rc
@@ -23,6 +23,8 @@ on init
 
     symlink /system/bin /bin
     symlink /system/etc /etc
+    rmdir /sbin
+    symlink /system/bin /sbin
 
     mkdir /sdcard
     mkdir /system
