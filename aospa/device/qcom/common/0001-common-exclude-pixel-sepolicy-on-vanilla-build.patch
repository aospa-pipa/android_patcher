Subject: [PATCH 1/7] common: exclude pixel sepolicy on vanilla build

Change-Id: I10266109195f239b420d913ed2ccf24eed84648e
Signed-off-by: Jprimero15 <jprimero155@gmail.com>
---
 sepolicy/SEPolicy.mk | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/sepolicy/SEPolicy.mk b/sepolicy/SEPolicy.mk
index 49f1ea9ba..1606a4b65 100644
--- a/sepolicy/SEPolicy.mk
+++ b/sepolicy/SEPolicy.mk
@@ -37,8 +37,10 @@ SYSTEM_EXT_PUBLIC_SEPOLICY_DIRS += \
 
 # AOSPA-QCOM Specific Required SEPolicy
 ifneq ($(AOSPA_BUILD),)
-    BOARD_VENDOR_SEPOLICY_DIRS += \
-        $(COMMON_SEPOLICY_PATH)/pixel/vendor
+   ifneq ($(TARGET_DISABLES_GMS), true)
+       BOARD_VENDOR_SEPOLICY_DIRS += \
+           $(COMMON_SEPOLICY_PATH)/pixel/vendor
+   endif
     SYSTEM_EXT_PRIVATE_SEPOLICY_DIRS += \
         $(COMMON_SEPOLICY_PATH)/aospa/private
 endif
